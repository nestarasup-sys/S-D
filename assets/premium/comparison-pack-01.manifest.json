{
  "format": "studio-dark-premium",
  "manifestVersion": 1,
  "id": "premium:comparison-pack-01",
  "name": "Comparison Pack · comparação editorial",
  "description": "Template demonstrativo editável com dois painéis, títulos, valores e descrições substituíveis.",
  "version": "1.0.0",
  "type": "premium-motion-template",
  "category": "motion-graphics",
  "tags": ["comparison", "documentary", "editorial", "data"],
  "preview": { "mode": "rendered-from-layers", "width": 480, "height": 270 },
  "dependencies": [],
  "canvas": { "width": 1280, "height": 720, "responsive": ["landscape", "portrait"] },
  "rootNodeId": "comparison-root",
  "layers": [
    { "id": "comparison-root", "kind": "group", "role": "root" },
    { "id": "comparison-eyebrow", "parentId": "comparison-root", "kind": "text", "role": "editorial-id" },
    { "id": "comparison-heading", "parentId": "comparison-root", "kind": "text", "role": "heading" },
    { "id": "comparison-panel-left", "parentId": "comparison-root", "kind": "group", "role": "left-panel" },
    { "id": "comparison-panel-bg-0", "parentId": "comparison-panel-left", "kind": "shape", "role": "panel-surface" },
    { "id": "comparison-panel-accent-0", "parentId": "comparison-panel-left", "kind": "shape", "role": "accent" },
    { "id": "comparison-left-title", "parentId": "comparison-panel-left", "kind": "text", "role": "slot:left-title" },
    { "id": "comparison-left-value", "parentId": "comparison-panel-left", "kind": "text", "role": "slot:left-value" },
    { "id": "comparison-left-description", "parentId": "comparison-panel-left", "kind": "text", "role": "slot:left-description" },
    { "id": "comparison-panel-right", "parentId": "comparison-root", "kind": "group", "role": "right-panel" },
    { "id": "comparison-panel-bg-1", "parentId": "comparison-panel-right", "kind": "shape", "role": "panel-surface" },
    { "id": "comparison-panel-accent-1", "parentId": "comparison-panel-right", "kind": "shape", "role": "accent" },
    { "id": "comparison-right-title", "parentId": "comparison-panel-right", "kind": "text", "role": "slot:right-title" },
    { "id": "comparison-right-value", "parentId": "comparison-panel-right", "kind": "text", "role": "slot:right-value" },
    { "id": "comparison-right-description", "parentId": "comparison-panel-right", "kind": "text", "role": "slot:right-description" },
    { "id": "comparison-divider", "parentId": "comparison-root", "kind": "shape", "role": "separator" },
    { "id": "comparison-footer", "parentId": "comparison-root", "kind": "text", "role": "source-reminder" }
  ],
  "hierarchy": { "root": "comparison-root", "parentReferences": "layers[].parentId", "remapIdsOnInstantiate": true },
  "suggestedAnimation": ["panel-reveal-left", "panel-reveal-right", "fade-out"],
  "palette": { "tokens": ["left", "right", "primary", "secondary", "accent", "highlight", "text", "muted"] },
  "slots": [
    { "id": "left-title", "kind": "text", "nodeId": "comparison-left-title", "role": "premium:comparison:left-title", "editable": true },
    { "id": "right-title", "kind": "text", "nodeId": "comparison-right-title", "role": "premium:comparison:right-title", "editable": true },
    { "id": "left-value", "kind": "text", "nodeId": "comparison-left-value", "role": "premium:comparison:left-value", "editable": true },
    { "id": "right-value", "kind": "text", "nodeId": "comparison-right-value", "role": "premium:comparison:right-value", "editable": true },
    { "id": "left-description", "kind": "text", "nodeId": "comparison-left-description", "role": "premium:comparison:left-description", "editable": true },
    { "id": "right-description", "kind": "text", "nodeId": "comparison-right-description", "role": "premium:comparison:right-description", "editable": true }
  ],
  "license": { "spdx": "LicenseRef-StudioDark-Original", "redistribution": "Studio Dark project only" },
  "origin": { "kind": "created-in-house", "thirdPartyAssets": false }
}
